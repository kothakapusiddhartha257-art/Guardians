# TRACEGUARD AI - Environment Configuration Example
# Copy this file to .env and configure your local credentials.

# Secret key for JWT session tokens
SECRET_KEY=traceguard-insecure-supersecret-jwt-key-2026-sih

# Gmail IMAP Dedicated Mailbox Credentials
GMAIL_EMAIL=kingkmn786@gmail.com
# Paste your 16-character Google App Password here (e.g. abcd efgh ijkl mnop)
GMAIL_APP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_FOLDER=INBOX

# Auto-scan polling configuration (default: false, manual scans)
