# Copy this file to .env and supply only the resources you have licensed.
# No integration treats unavailable data as a clean/safe result.

# MaxMind local databases (download separately from your MaxMind account)
GEOIP_DB_PATH=D:\security-data\GeoLite2-City.mmdb
GEOIP_ANONYMOUS_DB_PATH=D:\security-data\GeoIP2-Anonymous-IP.mmdb

# One IPv4/IPv6 address per line; keep this Tor exit-node list current.
TOR_EXIT_NODE_FILE=D:\security-data\tor-exit-nodes.txt

# Optional VPN/proxy provider. Do not commit real keys.
IPQUALITYSCORE_API_KEY=

# Optional reputation providers (connector pending activation)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# Local standalone-app users: comma-separated username:password pairs.
# Use a password manager to generate unique values; do not commit a real .env.
LOCAL_ANALYST_USERS=analyst_01:replace-with-a-strong-password
